# Base URL of the Express API (no trailing slash). Next.js rewrites /api/* to it,
# so the browser only talks to this app's origin and the auth cookie stays first-party.
API_URL=http://localhost:4000

# Must match the backend's JWT_SECRET — used by src/proxy.ts to verify the session cookie.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: shows a "Fill in demo credentials" helper on the login page (for reviewers).
NEXT_PUBLIC_DEMO_EMAIL=admin@doctortracker.com
NEXT_PUBLIC_DEMO_PASSWORD=Admin@12345
