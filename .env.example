# Base URL of the Express API (no trailing slash). Next.js rewrites /api/* to it,
# so the browser only talks to this app's origin and the auth cookies stay first-party.
# Also used server-side to prerender the public pages.
API_URL=http://localhost:4000

# Must match the backend's JWT_SECRET — used by src/proxy.ts to verify the session cookie.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Canonical site origin for SEO (canonical URLs, sitemap, structured data).
# Optional on Vercel: the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: one-click demo sign-in buttons on the login page, as
# "email:password" pairs for admin, doctor and patient (in that order).
NEXT_PUBLIC_DEMO_LOGINS=admin@doctortracker.com:Admin@12345,doctor@doctortracker.com:Doctor@12345,patient@doctortracker.com:Patient@12345
